<?xml version='1.0' encoding='utf-8'?>
<interface version="1.5" author="PygubuDesigner 0.41.4">
  <project>
    <settings>
      <setting id="name">segmented button test</setting>
      <setting id="description">a test</setting>
      <setting id="template">codescript</setting>
      <setting id="main_widget">ctk1</setting>
      <setting id="module_namespace" />
      <setting id="module_name">segementedbutton</setting>
      <setting id="main_classname">segementedbutton</setting>
      <setting id="output_dir">.</setting>
      <setting id="builder_namespace">custom_widgets</setting>
      <setting id="output_dir2" />
      <setting id="generate_code_onsave">False</setting>
      <setting id="use_i18n">False</setting>
      <setting id="all_ids_attributes">False</setting>
      <setting id="import_tkvariables">False</setting>
      <setting id="use_ttk_styledefinition_file">False</setting>
      <setting id="use_window_centering_code">False</setting>
      <setting id="ttk_style_definition_file" />
    </settings>
    <customwidgets>
      <customwidget path="../widgets/frameLabeledPrimarybo.py" />
    </customwidgets>
    <resources />
  </project>
  <object class="customtkinter.CTk" id="ctk1">
    <child>
      <object class="customtkinter.CTkFrame" id="ctkframe1">
        <layout manager="pack">
          <property name="side">top</property>
        </layout>
        <child>
          <object class="custom_widgets.frameLabeledPrimary" id="framelabeledprimary1">
            <property name="label_text">a test</property>
            <layout manager="pack">
              <property name="side">top</property>
            </layout>
            <child>
              <object class="customtkinter.CTkSegmentedButton" id="ctksegmentedbutton1">
                <property name="values">["apple", "orange", "pear"]</property>
                <layout manager="pack">
                  <property name="side">top</property>
                </layout>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
