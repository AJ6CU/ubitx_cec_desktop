<?xml version='1.0' encoding='utf-8'?>
<interface version="1.5" author="PygubuDesigner 0.41.4">
  <project>
    <settings>
      <setting id="name">sCTkbuttonPrimary</setting>
      <setting id="description">sublass of CTkButton</setting>
      <setting id="template">widget</setting>
      <setting id="main_widget">buttonPrimaryTemplate</setting>
      <setting id="module_namespace" />
      <setting id="module_name">sCTkButtonPrimary</setting>
      <setting id="main_classname">sCTkButtonPrimary</setting>
      <setting id="output_dir">../../sCustomTkinter</setting>
      <setting id="builder_namespace">custom_widgets</setting>
      <setting id="output_dir2">../../sCustomTkinter</setting>
      <setting id="generate_code_onsave">False</setting>
      <setting id="use_i18n">False</setting>
      <setting id="all_ids_attributes">False</setting>
      <setting id="import_tkvariables">False</setting>
      <setting id="use_ttk_styledefinition_file">True</setting>
      <setting id="use_window_centering_code">False</setting>
      <setting id="ttk_style_definition_file" />
    </settings>
    <customwidgets />
    <resources />
  </project>
  <object class="customtkinter.CTkFrame" id="ctkframe2">
    <layout manager="pack">
      <property name="side">top</property>
    </layout>
    <child>
      <object class="customtkinter.CTkButton" id="buttonPrimaryTemplate" named="True">
        <property name="text" translatable="yes">ctkbutton4</property>
        <layout manager="pack">
          <property name="expand">false</property>
          <property name="side">top</property>
        </layout>
      </object>
    </child>
  </object>
</interface>
