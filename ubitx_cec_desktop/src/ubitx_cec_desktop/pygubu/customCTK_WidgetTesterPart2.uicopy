<?xml version='1.0' encoding='utf-8'?>
<interface version="1.5" author="PygubuDesigner 0.41.4">
  <project>
    <settings>
      <setting id="name">customCTK_WidgetTesterPart2</setting>
      <setting id="description">just tests eah widget</setting>
      <setting id="template">codescript</setting>
      <setting id="main_widget">ctk1</setting>
      <setting id="module_namespace" />
      <setting id="module_name">customCTK_WidgetTesterPart2</setting>
      <setting id="main_classname">customCTK_WidgetTesterPart2</setting>
      <setting id="output_dir">../utilities</setting>
      <setting id="builder_namespace">custom_widgets</setting>
      <setting id="output_dir2" />
      <setting id="generate_code_onsave">False</setting>
      <setting id="use_i18n">False</setting>
      <setting id="all_ids_attributes">False</setting>
      <setting id="import_tkvariables">False</setting>
      <setting id="use_ttk_styledefinition_file">False</setting>
      <setting id="use_window_centering_code">False</setting>
      <setting id="ttk_style_definition_file" />
    </settings>
    <customwidgets>
      <customwidget path="../widgets/customCTK2.py" />
    </customwidgets>
    <resources />
  </project>
  <object class="customtkinter.CTk" id="ctk1">
    <child>
      <object class="customtkinter.CTkFrame" id="ctkframe1">
        <property name="border_color">green</property>
        <property name="border_width">2</property>
        <layout manager="grid">
          <property name="column">0</property>
          <property name="row">0</property>
        </layout>
        <child>
          <object class="custom_widgets.frameLabeledPrimary" id="framelabeledprimary5">
            <property name="label_anchor">w</property>
            <property name="label_text">CheckBox and ComboBox</property>
            <bind sequence="&lt;MouseWheel&gt;" handler="callback" add="" />
            <layout manager="grid">
              <property name="column">0</property>
              <property name="padx">20 10</property>
              <property name="pady">20</property>
              <property name="row">0</property>
              <property name="sticky">ew</property>
            </layout>
            <child>
              <object class="customtkinter.CTkLabel" id="ctklabel1">
                <property name="text" translatable="yes">ctk:</property>
                <layout manager="grid">
                  <property name="column">0</property>
                  <property name="padx">0 5</property>
                  <property name="row">0</property>
                  <property name="sticky">e</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="customtkinter.CTkCheckBox" id="ctkcheckbox1">
                <property name="text" translatable="yes">ctkCheckbox</property>
                <layout manager="grid">
                  <property name="column">1</property>
                  <property name="row">0</property>
                  <property name="sticky">w</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="customtkinter.CTkLabel" id="ctklabel2">
                <property name="text" translatable="yes">subCTk:</property>
                <layout manager="grid">
                  <property name="column">0</property>
                  <property name="padx">0 5</property>
                  <property name="row">1</property>
                  <property name="sticky">e</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="custom_widgets.checkBox" id="checkbox1">
                <property name="text" translatable="yes">subCheckbox</property>
                <layout manager="grid">
                  <property name="column">1</property>
                  <property name="row">1</property>
                  <property name="sticky">w</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="customtkinter.CTkLabel" id="ctklabel3">
                <property name="text" translatable="yes">ctk:</property>
                <layout manager="grid">
                  <property name="column">0</property>
                  <property name="padx">0 5</property>
                  <property name="pady">20 0</property>
                  <property name="row">2</property>
                  <property name="sticky">e</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="customtkinter.CTkComboBox" id="ctkcombobox1">
                <layout manager="grid">
                  <property name="column">1</property>
                  <property name="pady">20 0</property>
                  <property name="row">2</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="customtkinter.CTkLabel" id="ctklabel4">
                <property name="text" translatable="yes">subCTk:</property>
                <layout manager="grid">
                  <property name="column">0</property>
                  <property name="padx">0 5</property>
                  <property name="row">3</property>
                  <property name="sticky">e</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="custom_widgets.comboBox" id="combobox1">
                <property name="values">["apple","pear","grape"]</property>
                <layout manager="grid">
                  <property name="column">1</property>
                  <property name="row">3</property>
                </layout>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="custom_widgets.frameLabeledPrimary" id="framelabeled1">
            <property name="label_anchor">w</property>
            <property name="label_text">Progressbars and Sliders</property>
            <bind sequence="&lt;MouseWheel&gt;" handler="callback" add="" />
            <layout manager="grid">
              <property name="column">1</property>
              <property name="padx">20 10</property>
              <property name="pady">20</property>
              <property name="row">0</property>
              <property name="sticky">ew</property>
            </layout>
            <child>
              <object class="customtkinter.CTkLabel" id="ctklabel5">
                <property name="text" translatable="yes">ctk:</property>
                <layout manager="pack" />
              </object>
            </child>
            <child>
              <object class="customtkinter.CTkProgressBar" id="ctkprogressbar1">
                <layout manager="pack">
                  <property name="side">top</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="customtkinter.CTkLabel" id="ctklabel6">
                <property name="text" translatable="yes">subCTk:</property>
                <layout manager="pack" />
              </object>
            </child>
            <child>
              <object class="custom_widgets.progressBar" id="progressbar1">
                <layout manager="pack">
                  <property name="side">top</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="customtkinter.CTkLabel" id="ctklabel7">
                <property name="text" translatable="yes">ctk:</property>
                <layout manager="pack">
                  <property name="pady">20 0</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="customtkinter.CTkSlider" id="ctkslider1">
                <layout manager="pack">
                  <property name="side">top</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="customtkinter.CTkLabel" id="ctklabel8">
                <property name="text" translatable="yes">subCTk:</property>
                <layout manager="pack" />
              </object>
            </child>
            <child>
              <object class="custom_widgets.slider" id="slider1">
                <layout manager="pack">
                  <property name="side">top</property>
                </layout>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="custom_widgets.frameLabeledPrimary" id="framelabeledprimary6">
            <property name="label_anchor">w</property>
            <property name="label_text">RadioButton and Switch</property>
            <bind sequence="&lt;MouseWheel&gt;" handler="callback" add="" />
            <layout manager="grid">
              <property name="column">2</property>
              <property name="padx">20 10</property>
              <property name="pady">20</property>
              <property name="row">0</property>
              <property name="sticky">ew</property>
            </layout>
            <child>
              <object class="customtkinter.CTkLabel" id="ctklabel9">
                <property name="text" translatable="yes">ctk:</property>
                <layout manager="grid">
                  <property name="column">0</property>
                  <property name="padx">0 5</property>
                  <property name="row">0</property>
                  <property name="sticky">e</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="customtkinter.CTkLabel" id="ctklabel10">
                <property name="text" translatable="yes">subCTk:</property>
                <layout manager="grid">
                  <property name="column">0</property>
                  <property name="padx">0 5</property>
                  <property name="row">1</property>
                  <property name="sticky">e</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="customtkinter.CTkLabel" id="ctklabel11">
                <property name="text" translatable="yes">ctk:</property>
                <layout manager="grid">
                  <property name="column">0</property>
                  <property name="padx">0 5</property>
                  <property name="pady">20 0</property>
                  <property name="row">2</property>
                  <property name="sticky">e</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="customtkinter.CTkLabel" id="ctklabel12">
                <property name="text" translatable="yes">subCTk:</property>
                <layout manager="grid">
                  <property name="column">0</property>
                  <property name="padx">0 5</property>
                  <property name="row">3</property>
                  <property name="sticky">e</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="customtkinter.CTkRadioButton" id="ctkradiobutton" named="True">
                <property name="text" translatable="yes">ctkradiobutton</property>
                <layout manager="grid">
                  <property name="column">1</property>
                  <property name="row">0</property>
                  <property name="sticky">w</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="custom_widgets.radioButton" id="radiobutton1">
                <property name="text" translatable="yes">subradiobutton</property>
                <layout manager="grid">
                  <property name="column">1</property>
                  <property name="row">1</property>
                  <property name="sticky">w</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="customtkinter.CTkSwitch" id="ctkswitch1">
                <property name="text" translatable="yes">ctkswitch</property>
                <layout manager="grid">
                  <property name="column">1</property>
                  <property name="pady">20 0</property>
                  <property name="row">2</property>
                  <property name="sticky">w</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="custom_widgets.switch" id="switch1">
                <property name="text" translatable="yes">subswitch</property>
                <layout manager="grid">
                  <property name="column">1</property>
                  <property name="row">3</property>
                  <property name="sticky">w</property>
                </layout>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="custom_widgets.frameLabeledPrimary" id="framelabeledprimary2">
            <property name="label_anchor">w</property>
            <property name="label_text">Segmented Button</property>
            <layout manager="grid">
              <property name="column">0</property>
              <property name="row">1</property>
            </layout>
            <child>
              <object class="customtkinter.CTkLabel" id="ctklabel13">
                <property name="text" translatable="yes">ctk:</property>
                <layout manager="pack" />
              </object>
            </child>
          </object>
